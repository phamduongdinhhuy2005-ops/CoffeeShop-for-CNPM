@{
    ViewData["Title"] = "Tài Khoản | Góc Lặng";
    Layout = "_Layout";
    var user = ViewBag.User as WebBanHang_2380600870.Models.AppUser;
    var orders = ViewBag.Orders as List<WebBanHang_2380600870.Models.Order> ?? new();
    var activeTab = TempData["ActiveTab"]?.ToString() ?? "profile";
}

<section class="max-w-6xl mx-auto px-6 md:px-20 py-10">
    <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
        <aside class="rounded-xl border border-primary/20 bg-white p-5 h-fit">
            <div class="flex items-center gap-3 pb-5 border-b border-primary/10">
                <div class="h-11 w-11 rounded-full bg-primary text-white flex items-center justify-center font-bold">
                    @((user?.FullName ?? user?.Email ?? "U").Substring(0, 1).ToUpper())
                </div>
                <div class="min-w-0">
                    <div class="font-bold text-slate-custom truncate">@(user?.FullName ?? "Người dùng")</div>
                    <div class="text-xs text-teal-custom/70 truncate">@user?.Email</div>
                </div>
            </div>

            <nav class="pt-4 flex flex-col gap-2">
                <button type="button" class="ua-tab-btn @(activeTab == "profile" ? "active" : "")" data-tab="profile">
                    <span class="material-symbols-outlined">manage_accounts</span> Hồ sơ
                </button>
                <button type="button" class="ua-tab-btn @(activeTab == "orders" ? "active" : "")" data-tab="orders">
                    <span class="material-symbols-outlined">receipt_long</span> Đơn hàng
                    @if (orders.Any()) { <span class="ml-auto text-xs font-bold">@orders.Count</span> }
                </button>
                <button type="button" class="ua-tab-btn @(activeTab == "password" ? "active" : "")" data-tab="password">
                    <span class="material-symbols-outlined">lock_reset</span> Mật khẩu
                </button>
            </nav>
        </aside>

        <div class="space-y-5">
            @if (TempData["Success"] != null)
            {
                <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@TempData["Error"]</div>
            }

            <section class="ua-panel rounded-xl border border-primary/20 bg-white p-6 @(activeTab == "profile" ? "active" : "")" id="panel-profile">
                <h1 class="text-2xl font-bold text-slate-custom mb-5">Thông tin tài khoản</h1>
                <form asp-action="UpdateProfile" method="post" class="grid gap-4">
                    @Html.AntiForgeryToken()
                    <label class="grid gap-2 text-sm font-semibold text-teal-custom">
                        Họ tên
                        <input name="fullName" value="@user?.FullName" class="rounded-lg border-primary/20" />
                    </label>
                    <label class="grid gap-2 text-sm font-semibold text-teal-custom">
                        Số điện thoại
                        <input name="phoneNumber" value="@user?.PhoneNumber" class="rounded-lg border-primary/20" />
                    </label>
                    <div class="grid gap-2 text-sm text-teal-custom/80">
                        <div>Email: <strong>@user?.Email</strong></div>
                        <div>Ngày tạo: <strong>@user?.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
                    </div>
                    <button class="w-fit rounded-full bg-primary px-6 py-3 text-sm font-bold uppercase tracking-wider text-white">
                        Lưu thay đổi
                    </button>
                </form>
            </section>

            <section class="ua-panel rounded-xl border border-primary/20 bg-white p-6 @(activeTab == "orders" ? "active" : "")" id="panel-orders">
                <h1 class="text-2xl font-bold text-slate-custom mb-5">Lịch sử đặt hàng</h1>
                @if (!orders.Any())
                {
                    <div class="rounded-lg bg-background-light p-6 text-center">
                        <span class="material-symbols-outlined text-primary text-4xl">receipt_long</span>
                        <p class="mt-2 font-semibold text-slate-custom">Chưa có đơn hàng nào</p>
                        <a asp-controller="Menu" asp-action="Index" class="inline-flex mt-4 rounded-full bg-primary px-5 py-2 text-sm font-bold text-white">Xem thực đơn</a>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="text-left text-teal-custom/70">
                                <tr>
                                    <th class="py-3">Mã đơn</th>
                                    <th class="py-3">Ngày đặt</th>
                                    <th class="py-3">Tổng tiền</th>
                                    <th class="py-3">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders)
                                {
                                    <tr class="border-t border-primary/10">
                                        <td class="py-3 font-bold">#@order.Id</td>
                                        <td class="py-3">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="py-3">@order.TotalAmount.ToString("N0") đ</td>
                                        <td class="py-3">@order.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="ua-panel rounded-xl border border-primary/20 bg-white p-6 @(activeTab == "password" ? "active" : "")" id="panel-password">
                <h1 class="text-2xl font-bold text-slate-custom mb-5">Đổi mật khẩu</h1>
                <form asp-action="ChangePassword" method="post" class="grid gap-4">
                    @Html.AntiForgeryToken()
                    <input name="currentPassword" type="password" placeholder="Mật khẩu hiện tại" class="rounded-lg border-primary/20" />
                    <input name="newPassword" type="password" placeholder="Mật khẩu mới" class="rounded-lg border-primary/20" />
                    <input name="confirmPassword" type="password" placeholder="Xác nhận mật khẩu mới" class="rounded-lg border-primary/20" />
                    <button class="w-fit rounded-full bg-primary px-6 py-3 text-sm font-bold uppercase tracking-wider text-white">
                        Cập nhật mật khẩu
                    </button>
                </form>
            </section>
        </div>
    </div>
</section>

<style>
    .ua-tab-btn {
        display: flex;
        align-items: center;
        gap: .65rem;
        width: 100%;
        padding: .8rem .95rem;
        border-radius: .65rem;
        color: #3F4E4F;
        font-weight: 700;
        text-align: left;
        transition: background .15s, color .15s;
    }

    .ua-tab-btn:hover,
    .ua-tab-btn.active {
        background: rgba(162, 123, 92, .12);
        color: #A27B5C;
    }

    .ua-tab-btn .material-symbols-outlined {
        font-size: 20px;
    }

    .ua-panel {
        display: none;
    }

    .ua-panel.active {
        display: block;
    }
</style>

<script>
    document.querySelectorAll('.ua-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.ua-tab-btn').forEach(function (x) { x.classList.remove('active'); });
            document.querySelectorAll('.ua-panel').forEach(function (x) { x.classList.remove('active'); });
            btn.classList.add('active');
            document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
        });
    });
</script>
